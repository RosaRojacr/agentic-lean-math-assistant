      dI.RealContains (sqrt (lam ^ 2 - h ^ 2)) ∧
      asinHI.RealContains (arcsin h) ∧
      asinRI.RealContains (arcsin (h / lam)) :=
  CompactCellCertificate.typeFour_atoms_of_exact_bounds
    lambdaInterval hI uI dI asinHI asinRI hlam hh
