      (typeFourFold_cell_enclosure hlam hx) hpow
  have hdisp := LeanSuffixReflective.QInterval.realContains_sub hh
    (LeanSuffixReflective.QInterval.realContains_point h4Center (h4Center : ℝ) |>.2 rfl)
