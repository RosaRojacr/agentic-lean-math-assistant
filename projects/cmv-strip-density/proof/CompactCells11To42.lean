    h4AreaCenter.RealContains (LeanSuffixAnalytic.typeFourArea lam (h4Center : ℝ)) ∧
    h4PerimeterCenter.RealContains (LeanSuffixAnalytic.typeFourPerimeter lam (h4Center : ℝ)) := by
