        ScalarSuffixCertificate.QInterval.realContains_mul hx hx
    exact ScalarSuffixCertificate.QInterval.realContains_divPos
      (by norm_num [h4Square, h4Interval, ScalarSuffixCertificate.QInterval.mul])
