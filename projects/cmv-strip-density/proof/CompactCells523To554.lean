  typeThreeArea_upperFace_gap_neg := fun hlam hh hz =>
    typeThreeArea_upperFace_gap_neg hlam hh hz
  typeThreePerimeter_gap_neg := fun hlam hh3 hh4 =>
    typeThreePerimeter_gap_neg hlam hh3 hh4

