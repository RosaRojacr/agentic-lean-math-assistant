/-- Composition of the preceding aggregate with this bounded shard. -/
theorem boxes0To202_candidate_not_isWeightedPerimeterMinimizer
    {lam : ℝ}
    (hlower : (33 / 32 : ℝ) ≤ lam)
    (hupper : lam ≤ (35445 / 32768 : ℝ))
    (candidate : _root_.FourArcCandidate lam)
    (hcandidate : candidate.SatisfiesCMVTypeIVHypotheses) :
    ¬ candidate.IsWeightedPerimeterMinimizer := by
  by_cases hprefix : lam ≤ (246291 / 229376 : ℝ)
  · exact CompactCells139To170.boxes0To170_candidate_not_isWeightedPerimeterMinimizer
      hlower hprefix candidate hcandidate
  · exact boxes171To202_candidate_not_isWeightedPerimeterMinimizer
      (not_le.mp hprefix).le hupper candidate hcandidate

