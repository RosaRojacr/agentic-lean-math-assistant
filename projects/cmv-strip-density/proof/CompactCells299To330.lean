/-- Composition of the preceding aggregate with this bounded shard. -/
theorem boxes0To330_candidate_not_isWeightedPerimeterMinimizer
    {lam : ℝ}
    (hlower : (33 / 32 : ℝ) ≤ lam)
    (hupper : lam ≤ (255411 / 229376 : ℝ))
    (candidate : _root_.FourArcCandidate lam)
    (hcandidate : candidate.SatisfiesCMVTypeIVHypotheses) :
    ¬ candidate.IsWeightedPerimeterMinimizer := by
  by_cases hprefix : lam ≤ (253587 / 229376 : ℝ)
  · exact CompactCells267To298.boxes0To298_candidate_not_isWeightedPerimeterMinimizer
      hlower hprefix candidate hcandidate
  · exact boxes299To330_candidate_not_isWeightedPerimeterMinimizer
      (not_le.mp hprefix).le hupper candidate hcandidate

end CompactCells299To330
