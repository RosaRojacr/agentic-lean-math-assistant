      (typeFourFold_cell_enclosure hlam hx) hpow
  have hslope2 : ∀ x, h4Interval.RealContains x →
      h4PerimeterSlope.RealContains (LeanSuffixAnalytic.typeFourFold lam x / x^2) := by
    intro x hx
