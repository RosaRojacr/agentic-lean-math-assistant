  · exact CompactCellCertificate.typeFourArea_centered_enclosure lambdaInterval h4Interval
      h4Center hlam hh h4Center_mem (lambda_one_lt hlam)
      (fun hx => h4_slab_regular hx) h4AreaCenter h4AreaSlope h4Displacement
