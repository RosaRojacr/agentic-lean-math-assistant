      1 - (((CompactCellCertificate.typeFourShiftedInterval hI).nsmul 2
        (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).lo ^ 2 ≤
          uI.hi ^ 2 ∧
      0 ≤ dI.lo ∧
