  h4_slab_regular := fun hh => h4_slab_regular hh
  typeFourFold_lowerFace_neg := fun hlam => typeFourFold_lowerFace_neg hlam
  typeFourFold_upperFace_pos := fun hlam => typeFourFold_upperFace_pos hlam
