          (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).hi ^ 2 ∧
      lambdaInterval.hi ^ 2 -
        (((CompactCellCertificate.typeFourShiftedInterval hI).nsmul 2
          (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).lo ^ 2 ≤
