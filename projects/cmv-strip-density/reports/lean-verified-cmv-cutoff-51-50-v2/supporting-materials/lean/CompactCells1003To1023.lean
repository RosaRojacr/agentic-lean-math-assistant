      (((CompactCellCertificate.typeFourShiftedInterval hI).nsmul 2
        (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).hi ≤
          (ScalarSuffixCertificate.sinTaylor27Interval asinHI.hi).lo ∧
