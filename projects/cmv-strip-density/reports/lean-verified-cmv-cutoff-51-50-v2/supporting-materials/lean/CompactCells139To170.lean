    (typeThreeCenter_atoms hlam) (by norm_num [lambdaInterval])
    (by norm_num [h3Center, h3Interval, LeanSuffixReflective.QInterval.point])
    (by norm_num [h3Center, h3Interval, ScalarSuffixCertificate.QInterval.mul,
