  rcases typeFour_center_enclosures hlam with ⟨harea,hper⟩
  have hslope3 : ∀ x, h4Interval.RealContains x →
      h4AreaSlope.RealContains (LeanSuffixAnalytic.typeFourFold lam x / x^3) := by
