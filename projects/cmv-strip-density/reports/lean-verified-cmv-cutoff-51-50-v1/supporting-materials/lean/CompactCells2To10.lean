        (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).lo ∧
      (((CompactCellCertificate.typeFourShiftedInterval hI).nsmul 2
        (by norm_num)).sub (LeanSuffixReflective.QInterval.point 1)).hi ≤ 1 ∧
      0 ≤ uI.lo ∧
